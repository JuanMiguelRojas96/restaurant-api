# Never ship secrets, git history, local dependencies or local caches inside the image.
.git
.github
.env
.env.*
!.env.example
vendor
node_modules
tests
phpunit.xml
.phpunit.cache
.phpunit.result.cache
storage/api-docs
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
.idea
.vscode
.DS_Store
*.log
